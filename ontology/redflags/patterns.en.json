{
  "version": "1.0.0",
  "language": "en",
  "description": "Deterministic red-flag text patterns (English). Red-flag detection runs BEFORE any LLM; the urgent-care script is never LLM-generated. Categories: urgent red flags force the urgent-care script first; safeguarding categories route to the safeguarding lead and NEVER to a guardian alert (spec 3.3).",
  "patterns": [
    { "id": "en-severe-pain-01", "category": "severe_acute_pain", "urgency": "RED", "regex": "(worst|unbearable|terrible|excruciating) pain (of|in) my (life|lower belly|tummy)" },
    { "id": "en-severe-pain-02", "category": "severe_acute_pain", "urgency": "RED", "regex": "sudden (severe|sharp) pain" },
    { "id": "en-severe-pain-03", "category": "severe_acute_pain", "urgency": "RED", "regex": "pain (is )?(10|9|a ten|a nine)( out of (10|ten))?" },
    { "id": "en-bleed-dizzy-01", "category": "heavy_bleeding_dizziness", "urgency": "RED", "regex": "soaking (through )?(a|more than one) pad" },
    { "id": "en-bleed-dizzy-02", "category": "heavy_bleeding_dizziness", "urgency": "RED", "regex": "(bleeding|period) (heavily|very heavily|a lot) and (i (feel|am feeling) )?(dizzy|faint|lightheaded)" },
    { "id": "en-bleed-dizzy-03", "category": "heavy_bleeding_dizziness", "urgency": "RED", "regex": "(passed out|fainted|blacked out)" },
    { "id": "en-self-harm-01", "category": "self_harm", "urgency": "SAFEGUARDING", "regex": "(want|wish) to (hurt|harm|kill|end) myself" },
    { "id": "en-self-harm-02", "category": "self_harm", "urgency": "SAFEGUARDING", "regex": "self[- ]?harm" },
    { "id": "en-self-harm-03", "category": "self_harm", "urgency": "SAFEGUARDING", "regex": "(no reason|don't want|dont want) to (live|go on|be alive)" },
    { "id": "en-abuse-01", "category": "abuse_signal", "urgency": "SAFEGUARDING", "regex": "(he|someone|a man|my uncle|my teacher|my neighbour|my neighbor) (touched|forced|made) me" },
    { "id": "en-abuse-02", "category": "abuse_signal", "urgency": "SAFEGUARDING", "regex": "(scared|afraid) of (him|my father|my uncle|my guardian|my stepfather|my teacher)" },
    { "id": "en-pregnancy-minor-01", "category": "pregnancy_concern_minor", "urgency": "SAFEGUARDING", "regex": "((am i|i think i('| a)?m|i might be|could i be) pregnant)" },
    { "id": "en-guardian-risk-01", "category": "guardian_risk", "urgency": "SAFEGUARDING", "regex": "my (father|uncle|stepfather|guardian) (hits|hurts|beats|touches) me" },
    { "id": "en-guardian-risk-02", "category": "guardian_risk", "urgency": "SAFEGUARDING", "regex": "he (comes|creeps) (into|to) my (bed|room) (at night|at night)" }
  ]
}
