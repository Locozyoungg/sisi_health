<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SisiApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sisi">

        <!-- On-demand WorkManager initialization (SisiApp implements Configuration.Provider):
             remove the default initializer per the WorkManager docs. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Discreet icon/name option (spec 5.1): a neutral "Notes" launcher entry,
             disabled by default, toggled in Settings. Nothing condition-identifying
             appears in the launcher or app switcher. -->
        <activity-alias
            android:name="com.sisi.health.DiscreetAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:label="@string/discreet_app_name"
            android:icon="@mipmap/ic_launcher_discreet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
