{
  "version": "1.0.0",
  "language": "sw",
  "description": "Mifumo ya red-flag (Kiswahili). Red-flag hugunduliwa KABLA ya LLM; script ya dharura haitokani na LLM kamwe. Categories za safeguarding huelekezwa kwa msimamizi wa ulinzi, si kwa mzazi (spec 3.3).",
  "patterns": [
    { "id": "sw-severe-pain-01", "category": "severe_acute_pain", "urgency": "RED", "regex": "maumivu (makali|ya ghafla|yasiyovumilika|ya kutisha)" },
    { "id": "sw-severe-pain-02", "category": "severe_acute_pain", "urgency": "RED", "regex": "maumivu (ya|kama) (kisu|visu)" },
    { "id": "sw-severe-pain-03", "category": "severe_acute_pain", "urgency": "RED", "regex": "maumivu (10|kumi|9|tisa)( kati ya (10|kumi))?" },
    { "id": "sw-bleed-dizzy-01", "category": "heavy_bleeding_dizziness", "urgency": "RED", "regex": "damu (nyingi|nyingi sana)( na)?( naskia)?( kizunguzungu|kuzimia)" },
    { "id": "sw-bleed-dizzy-02", "category": "heavy_bleeding_dizziness", "urgency": "RED", "regex": "(kizunguzungu|naweweseka|kuzimia)" },
    { "id": "sw-bleed-dizzy-03", "category": "heavy_bleeding_dizziness", "urgency": "RED", "regex": "pedi (inalowa|zinajaa) (kila|ndani ya) (saa|dakika)" },
    { "id": "sw-self-harm-01", "category": "self_harm", "urgency": "SAFEGUARDING", "regex": "(nataka|ninataka) kuji(umiza|ua)" },
    { "id": "sw-self-harm-02", "category": "self_harm", "urgency": "SAFEGUARDING", "regex": "kuji(umiza|ua)" },
    { "id": "sw-self-harm-03", "category": "self_harm", "urgency": "SAFEGUARDING", "regex": "maisha (hayana|yamepoteza) maana" },
    { "id": "sw-abuse-01", "category": "abuse_signal", "urgency": "SAFEGUARDING", "regex": "(alinigusa|alinilazimisha|alinibaka)" },
    { "id": "sw-abuse-02", "category": "abuse_signal", "urgency": "SAFEGUARDING", "regex": "(namuogopa|namwogopa) (baba|mjomba|mlezi|babangu|mwalimu)" },
    { "id": "sw-pregnancy-minor-01", "category": "pregnancy_concern_minor", "urgency": "SAFEGUARDING", "regex": "(nafikiri|nadhani)( nina| niko na| naweza kuwa na) mimba" },
    { "id": "sw-guardian-risk-01", "category": "guardian_risk", "urgency": "SAFEGUARDING", "regex": "(baba|mjomba|mlezi)( yangu| wangu)? (ananipiga|ananiumiza|ananigusa)" },
    { "id": "sw-guardian-risk-02", "category": "guardian_risk", "urgency": "SAFEGUARDING", "regex": "anakuja (kitandani|chumbani) (usiku|kila usiku)" }
  ]
}
