# SISI Health — environment template. Copy to .env and fill. NEVER commit .env.
# All SISI_* values are read by backend/app/config.py (pydantic-settings).

SISI_ENV=dev                      # dev | demo | staging | prod
SISI_DATABASE_URL=postgresql+psycopg://sisi:sisi_dev_pw@localhost:5432/sisi
SISI_TEST_DATABASE_URL=postgresql+psycopg://sisi:sisi_dev_pw@localhost:5432/sisi_test
SISI_REDIS_URL=redis://localhost:6379/0

# Auth (prod: generate strong random values)
SISI_JWT_SECRET=dev-only-secret-change-me-32-bytes-minimum!
SISI_PHONE_PEPPER=dev-only-pepper-change-me

# CORS (Phase 8). Dev/demo: empty means the wildcard. Staging/prod: REQUIRED
# comma-separated browser-origin list; empty refuses to boot.
SISI_CORS_ORIGINS=

# Staff login brute-force throttle (CC-6, Phase 8): failures per sliding window
# before lockout, window length, and lockout duration.
SISI_STAFF_LOGIN_MAX_FAILURES=5
SISI_STAFF_LOGIN_WINDOW_MINUTES=10
SISI_STAFF_LOGIN_LOCKOUT_MINUTES=15

# Master key for envelope encryption. Dev/demo: auto-generated at data/master.key
# (gitignored). Staging/prod: provide SISI_MASTER_KEY_B64 (32 random bytes, base64).
SISI_MASTER_KEY_B64=

# Safety flags. staging/prod refuse to boot unless these are false.
SISI_ALLOW_UNVALIDATED_RULES=true
SISI_OTP_DEV_RETURN=true

# Compliance config (defaults recorded in /docs/assumptions.md pending counsel)
SISI_SELF_CONSENT_AGE=18
SISI_DSR_DEADLINE_DAYS=30
SISI_RETENTION_DIARY_DAYS=2555
SISI_RETENTION_AUDIT_DAYS=3650
SISI_RETENTION_VOUCHER_DAYS=730

# Hotlines — UNVERIFIED, confirm before launch (kept in config, never hard-coded)
SISI_HELPLINE_CHILD=116
SISI_HELPLINE_GBV=1195

# OTP
SISI_OTP_TTL_SECONDS=300
SISI_OTP_MAX_REQUESTS_PER_WINDOW=5
SISI_OTP_MAX_FAILURES=10

# Corridor (Phase 5). Jitsi: contract-level in dev — the backend signs one-time
# room JWTs with SISI_JITSI_APP_SECRET; staging/prod refuse the dev default.
# Server/account provisioning is human task H12.
SISI_JITSI_DOMAIN=meet.sisi-health.local
SISI_JITSI_APP_ID=sisi
SISI_JITSI_APP_SECRET=dev-only-jitsi-secret-change-me

# AI service (Phase 6). NEVER commit real credentials (non-negotiable 7).
# Dev/demo: stub providers (deterministic, no keys). staging/prod refuse stubs.
SISI_AI_LLM_PROVIDER=stub                  # stub | hosted | openweight
SISI_AI_HOSTED_API_KEY=
SISI_AI_HOSTED_BASE_URL=https://api.anthropic.com
SISI_AI_HOSTED_MODEL=
SISI_AI_OPENWEIGHT_BASE_URL=http://localhost:8000/v1
SISI_AI_OPENWEIGHT_MODEL=
SISI_AI_EMBEDDING_PROVIDER=stub            # stub | bge_m3
SISI_AI_EMBEDDING_BASE_URL=http://localhost:8001/v1
SISI_AI_EMBEDDING_API_KEY=
SISI_AI_EMBEDDING_DIM=768
SISI_AI_INTERNAL_TOKEN=dev-only-ai-token-change-me
# Cost sheet placeholders (USD per 1,000 tokens) — zero until H15 (A37)
SISI_AI_PRICE_HOSTED_IN=0.0
SISI_AI_PRICE_HOSTED_OUT=0.0
SISI_AI_PRICE_OPENWEIGHT_IN=0.0
SISI_AI_PRICE_OPENWEIGHT_OUT=0.0
