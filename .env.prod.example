# SISI Health — STAGING/PRODUCTION environment template.
#
#   cp .env.prod.example .env.prod      # then fill every value below
#   ./scripts/deploy.sh staging         # or: .\scripts\deploy.ps1 prod
#
# .env.prod is gitignored (`.env.*` with an exception for this template) and MUST
# NEVER be committed (non-negotiable 7). Generate every secret on the deployment host
# with a CSPRNG and store it in the operator's secret manager, not in a shell history:
#
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# EVERY VALUE BELOW IS EMPTY ON PURPOSE. docker-compose.prod.yml substitutes these with
# empty defaults so `docker compose config` works anywhere, and the application refuses
# to boot on a missing secret: backend/app/config.py `_prod_guards` raises for a
# missing/placeholder JWT secret, phone pepper, Jitsi secret or master key whenever
# SISI_ENV is staging or prod. A half-filled file therefore fails loudly at startup
# instead of serving traffic with a development default.
#
# The deploy script additionally refuses to run while a dev flag is switched on or a
# development default secret is still in place (see scripts/deploy.sh).

# ---------------------------------------------------------------------------
# Environment identity
# ---------------------------------------------------------------------------
# staging | prod. Set by the deploy script from its argument; must not be dev/demo.
SISI_DEPLOY_ENV=staging

# Public hostname Caddy obtains a certificate for, and the ACME contact address.
SISI_DOMAIN=
SISI_ACME_EMAIL=

# ---------------------------------------------------------------------------
# Database and cache
# ---------------------------------------------------------------------------
# Password for the `sisi` PostgreSQL role. Also used to build the service DSN
# (postgresql+psycopg://sisi:<password>@db:5432/sisi) — containers never use localhost.
# REQUIRED, no default. Empty means the postgres image refuses to initialise.
SISI_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Prod-guard secrets — all REQUIRED, all empty here
# ---------------------------------------------------------------------------
# Auth (users): short-lived JWT signing key, >= 32 bytes of entropy.
SISI_JWT_SECRET=
# Phone-number pepper used for the hash that stands in for the raw number.
SISI_PHONE_PEPPER=
# Envelope-encryption master key: 32 random bytes, base64-encoded. Wraps every
# per-record data key in core.data_keys. LOSING THIS KEY DESTROYS ALL DIARY CONTENT
# even with a perfect database backup — back it up separately, never next to the dump.
# Generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
SISI_MASTER_KEY_B64=
# Telehealth (self-hosted Jitsi, human task H12): the secret the backend signs
# one-time room JWTs with. Empty means /v1/corridor/sessions/* refuses to start.
SISI_JITSI_APP_SECRET=
SISI_JITSI_DOMAIN=
SISI_JITSI_APP_ID=sisi

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. REQUIRED in staging/prod: the
# wildcard is dev/demo-only and a missing list is refused (app/main.py). In the
# default single-host layout the console is same-origin, so this is usually just
# the console's own URL.
#   SISI_CORS_ORIGINS=https://sisi.example.org
SISI_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# AI service (internal-only, bearer-token gated)
# ---------------------------------------------------------------------------
# Shared token between the backend/gateway and the AI service. REQUIRED in
# staging/prod; the dev default is refused. Long random string, not a password.
SISI_AI_INTERNAL_TOKEN=
# hosted | openweight — `stub` is refused in staging/prod.
#   hosted     = a hosted API (default); requires the key and model below.
#   openweight = Llama/Qwen served by vLLM on a separate GPU host (build-order
#                requirement: implemented and eval-compared before pilot).
SISI_AI_LLM_PROVIDER=hosted
SISI_AI_HOSTED_API_KEY=
SISI_AI_HOSTED_BASE_URL=https://api.anthropic.com
SISI_AI_HOSTED_MODEL=
# Only for SISI_AI_LLM_PROVIDER=openweight:
SISI_AI_OPENWEIGHT_BASE_URL=
SISI_AI_OPENWEIGHT_MODEL=
# bge_m3 | stub — `stub` is refused in staging/prod.
SISI_AI_EMBEDDING_PROVIDER=bge_m3
SISI_AI_EMBEDDING_BASE_URL=
SISI_AI_EMBEDDING_API_KEY=
SISI_AI_EMBEDDING_MODEL=
# Must match ai.chunk_embeddings (migration 0007). Change only with a re-index.
SISI_AI_EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# Channel providers (human tasks H2/H3/H4 — empty until contracts are signed)
# ---------------------------------------------------------------------------
# Africa's Talking: USSD + SMS. The provider refuses to send without these rather
# than pretending a message went out.
SISI_AT_USERNAME=
SISI_AT_API_KEY=
# Turn.io / WhatsApp Business API.
SISI_TURN_TOKEN=
# USSD session state: redis in staging/prod (Postgres fallback exists for dev).
SISI_USSD_SESSION_BACKEND=redis
SISI_USSD_SESSION_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Compliance configuration (defaults recorded in docs/assumptions.md A1-A4)
# ---------------------------------------------------------------------------
# Counsel decides whether any age within 13-17 may self-consent: config, not code.
SISI_SELF_CONSENT_AGE=18
SISI_DSR_DEADLINE_DAYS=30
SISI_RETENTION_DIARY_DAYS=2555
SISI_RETENTION_AUDIT_DAYS=3650
SISI_RETENTION_VOUCHER_DAYS=730

# ---------------------------------------------------------------------------
# Hotlines — UNVERIFIED. CONFIRM BOTH BEFORE LAUNCH (see docs/runbook.md)
# ---------------------------------------------------------------------------
# These are shown to a child in crisis, so an unverified number is a safety defect,
# not a cosmetic one. 116 (child helpline) and 1195 (GBV helpline) are the numbers
# recorded in the spec; keep them in config so correction needs no code change.
SISI_HELPLINE_CHILD=116
SISI_HELPLINE_GBV=1195

# ---------------------------------------------------------------------------
# Session and OTP policy
# ---------------------------------------------------------------------------
SISI_OTP_TTL_SECONDS=300
SISI_OTP_MAX_REQUESTS_PER_WINDOW=5
SISI_OTP_MAX_FAILURES=10
SISI_ACCESS_TOKEN_MINUTES=15
SISI_REFRESH_TOKEN_DAYS=30
SISI_STAFF_IDLE_MINUTES=15
